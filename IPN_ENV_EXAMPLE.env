# =============================================================================
# Yo Payments IPN Configuration
# =============================================================================
# Copy these variables to your .env file and update the URLs with your actual domain
# =============================================================================

# Enable IPN (Instant Payment Notification)
YO_PAYMENTS_IPN_ENABLED=true

# IPN URLs for payment status confirmation
# Replace 'yourdomain.com' with your actual domain name
YO_PAYMENTS_IPN_SUCCESS_URL=https://yourdomain.com/payment/callback
YO_PAYMENTS_IPN_FAILURE_URL=https://yourdomain.com/payment/failed
YO_PAYMENTS_IPN_PENDING_URL=https://yourdomain.com/payment/callback

# IPN Configuration
YO_PAYMENTS_IPN_TIMEOUT=30
YO_PAYMENTS_IPN_RETRY_ATTEMPTS=3

# Security Configuration (Optional but Recommended)
YO_PAYMENTS_PUBLIC_KEY_ENABLED=true
YO_PAYMENTS_PUBLIC_KEY_PATH=storage/keys/yo_payments_public_key.pem

# =============================================================================
# Example with actual domain (replace with your domain):
# =============================================================================
# YO_PAYMENTS_IPN_SUCCESS_URL=https://wifihyper.com/payment/callback
# YO_PAYMENTS_IPN_FAILURE_URL=https://wifihyper.com/payment/failed
# YO_PAYMENTS_IPN_PENDING_URL=https://wifihyper.com/payment/callback
# =============================================================================

# =============================================================================
# Important Notes:
# =============================================================================
# 1. These URLs must be accessible from the internet
# 2. SSL (https://) is required for production
# 3. The routes are already defined in your Laravel application
# 4. CSRF protection is disabled for these routes (required for webhooks)
# 5. Configure these same URLs in your Yo Payments dashboard
# ============================================================================= 