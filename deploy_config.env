# =============================================================================
# WIFIHYPER Production Deployment Configuration
# =============================================================================
# Copy this file to your server and modify the values as needed
# Then use: ./deploy_production.sh --config=deploy_config.env
# =============================================================================

# Domain Configuration
DOMAIN=wifihyper.com
ADMIN_EMAIL=admin@wifihyper.com

# Database Configuration
DB_NAME=wifihyper
DB_USER=wifihyper
DB_PASS=your_secure_password_here

# Deployment Options
SKIP_SSL=false
SKIP_BACKUP=false
FORCE=false

# Server Configuration
DEPLOYMENT_DIR=/var/www/wifihyper
BACKUP_DIR=/var/backups/wifihyper

# Repository Configuration
GIT_REPO=https://github.com/yourusername/wifihyper.git
GIT_BRANCH=main

# SSL Configuration
SSL_EMAIL=admin@wifihyper.com
SSL_COUNTRY=UG
SSL_STATE=Kampala
SSL_LOCALITY=Kampala
SSL_ORGANIZATION=WIFIHYPER
SSL_ORG_UNIT=IT Department

# PHP Configuration
PHP_VERSION=8.2
PHP_MEMORY_LIMIT=512M
PHP_UPLOAD_MAX_FILESIZE=100M
PHP_POST_MAX_SIZE=100M
PHP_MAX_EXECUTION_TIME=300

# MySQL Configuration
MYSQL_ROOT_PASSWORD=your_mysql_root_password
MYSQL_CHARSET=utf8mb4
MYSQL_COLLATION=utf8mb4_unicode_ci

# Redis Configuration
REDIS_PASSWORD=your_redis_password
REDIS_MAX_MEMORY=256mb

# Apache Configuration
APACHE_SERVER_NAME=wifihyper.com
APACHE_DOCUMENT_ROOT=/var/www/wifihyper/public
APACHE_LOG_DIR=/var/log/apache2/wifihyper

# Security Configuration
FIREWALL_ENABLED=true
FAIL2BAN_ENABLED=true
SECURITY_HEADERS_ENABLED=true

# Monitoring Configuration
LOG_ROTATION_DAYS=7
MONITORING_INTERVAL=15
ALERT_EMAIL_ENABLED=true

# Backup Configuration
BACKUP_RETENTION_DAYS=30
BACKUP_COMPRESSION=true
BACKUP_ENCRYPTION=false

# Performance Configuration
OPCACHE_ENABLED=true
OPCACHE_MEMORY_CONSUMPTION=128
OPCACHE_MAX_ACCELERATED_FILES=4000
OPCACHE_REVALIDATE_FREQ=2

# Queue Configuration
QUEUE_WORKERS=2
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database-uuids

# Cache Configuration
CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis 