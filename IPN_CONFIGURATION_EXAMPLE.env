# Yo Payments IPN (Instant Payment Notification) Configuration
# Update your .env file with these values for wifihyper.com

# IPN Success Notification URL (Instant Payment Notification)
# This URL will receive notifications when payments are successful
YO_PAYMENTS_IPN_SUCCESS_URL=https://wifihyper.com/payment/callback

# IPN Failure Notification URL
# This URL will receive notifications when payments fail
YO_PAYMENTS_IPN_FAILURE_URL=https://wifihyper.com/payment/failed

# IPN Pending Notification URL
# This URL will receive notifications for pending payments
YO_PAYMENTS_IPN_PENDING_URL=https://wifihyper.com/payment/callback

# Enable/Disable IPN notifications
YO_PAYMENTS_IPN_ENABLED=true

# IPN timeout in seconds
YO_PAYMENTS_IPN_TIMEOUT=30

# IPN retry attempts
YO_PAYMENTS_IPN_RETRY_ATTEMPTS=3

# Example with query parameters (properly encoded)
# YO_PAYMENTS_IPN_SUCCESS_URL=https://wifihyper.com/payment/callback?source=yo_payments&type=success
# YO_PAYMENTS_IPN_FAILURE_URL=https://wifihyper.com/payment/failed?source=yo_payments&type=failure

# Note: The system automatically handles XML escaping for special characters:
# & becomes &amp;
# < becomes &lt;
# > becomes &gt;
# " becomes &quot;
# ' becomes &apos; 