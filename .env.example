### **Application Configuration**
APP_NAME=WIFIHYPER
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost
APP_KEY=base64:

### **Database Configuration**
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=root
DB_PASSWORD=

### **Cache & Session Configuration**
CACHE_DRIVER=redis
SESSION_DRIVER=database
QUEUE_CONNECTION=redis

### **Redis Configuration**
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

### **Mail Configuration (Resend)**
MAIL_MAILER=resend
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=WIFIHYPER
RESEND_KEY=
RESEND_WEBHOOK_SECRET=

### **SMS Gateway Configuration (UG SMS)**
UG_SMS_USERNAME=
UG_SMS_PASSWORD=
UG_SMS_SENDER_ID=

### **Payment Gateway Configuration (Yo! Payments)**
YO_PAYMENTS_USERNAME=
YO_PAYMENTS_PASSWORD=
YO_PAYMENTS_BASE_URL=https://paymentsapi1.yo.co.ug/ybs/task.php
YO_PAYMENTS_FALLBACK_URL=https://paymentsapi2.yo.co.ug/ybs/task.php
YO_PAYMENTS_PUBLIC_KEY_ENABLED=false
YO_PAYMENTS_PRIVATE_KEY_PATH=storage/keys/yo_payments_private_key.pem

### **Security Configuration**
SECURITY_LOGIN_ATTEMPTS=5
SECURITY_LOGIN_DECAY_MINUTES=1
SECURITY_API_REQUESTS=60
SECURITY_API_DECAY_MINUTES=1
SECURITY_SESSION_TIMEOUT=30
SECURITY_SESSION_REGENERATE_INTERVAL=300
SECURITY_SECURE_COOKIES=true
SECURITY_HTTP_ONLY_COOKIES=true
SECURITY_PASSWORD_MIN_LENGTH=8
SECURITY_PASSWORD_REQUIRE_UPPERCASE=true
SECURITY_PASSWORD_REQUIRE_LOWERCASE=true
SECURITY_PASSWORD_REQUIRE_NUMBERS=true
SECURITY_PASSWORD_REQUIRE_SPECIAL_CHARS=true
SECURITY_PASSWORD_MAX_AGE_DAYS=90
SECURITY_LOGGING_ENABLED=true
SECURITY_LOGGING_CHANNEL=security
SECURITY_MAX_FILE_SIZE_KB=1024
SECURITY_SCAN_UPLOADS=true

### **Logging Configuration**
LOG_CHANNEL=daily
LOG_LEVEL=info
LOG_DAILY_DAYS=30

### **File Upload Configuration**
FILESYSTEM_DISK=local

### **Queue Configuration**
QUEUE_FAILED_DRIVER=database-uuids

### **Session Configuration**
SESSION_LIFETIME=30
SESSION_EXPIRE_ON_CLOSE=true

### **Timezone Configuration**
APP_TIMEZONE=Africa/Kampala

### **Maintenance Mode**
APP_MAINTENANCE=false

### **Trusted Proxies**
TRUSTED_PROXIES=*

### **Rate Limiting**
RATE_LIMIT_ENABLED=true
RATE_LIMIT_ATTEMPTS=5
RATE_LIMIT_DECAY_MINUTES=1


### **Backup Configuration**
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=30
BACKUP_TIME=02:00

### **Monitoring Configuration**
MONITORING_ENABLED=true
MONITORING_HEALTH_CHECK_URL=/up

### **Development Overrides**
DEVELOPMENT_MODE=false
DEBUG_MODE=false

### **IPN (Instant Payment Notification) Configuration**
YO_PAYMENTS_IPN_UNIFIED_URL=https://wifihyper.com/payment/ipn
YO_PAYMENTS_IPN_SUCCESS_URL=https://wifihyper.com/payment/callback
YO_PAYMENTS_IPN_FAILURE_URL=https://wifihyper.com/payment/failed
YO_PAYMENTS_IPN_PENDING_URL=https://wifihyper.com/payment/callback
YO_PAYMENTS_IPN_ENABLED=true
YO_PAYMENTS_IPN_TIMEOUT=30
YO_PAYMENTS_IPN_RETRY_ATTEMPTS=3
